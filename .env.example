# Copy this file to .env and fill in values

# Up Bank webhook secret (returned when creating the webhook)
UP_WEBHOOK_SECRET=

# Up API personal access token (to fetch transaction details)
UP_API_TOKEN=

# Actual server connection
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
# Budget Sync ID (Settings → Advanced → Sync ID)
ACTUAL_BUDGET_ID=
# Optional: end-to-end encryption password for the budget file
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
# Where to cache budget data locally
ACTUAL_DATA_DIR=.actual-data

# Map Up account IDs to Actual account IDs (JSON object)
# Example: {"1234-up-account-id":"abcd-actual-account-id"}
ACCOUNT_MAP={}

# Covers. A shared Up saver -> the Actual category its spending belongs to. Used
# when the other 2Up owner covers from a pot and we cannot see their purchase.
# Example: {"up-groceries-saver-id":"actual-groceries-category-id"}
POT_CATEGORY_MAP={}
# Payee and note used for those covers
FOREIGN_COVER_PAYEE=Shane Cover
FOREIGN_COVER_NOTE=#update-payee
# Note added when a cover could not be matched to a purchase, or matched ambiguously
CHECK_COVER_NOTE=#check-cover
# How many days back from a cover to look for the purchase it paid for.
# Manual covers often land a week or more after the purchase.
ABSORB_WINDOW_DAYS=14


# MARVIS on Telegram (optional). Create a bot with @BotFather, message it once,
# run /whoami to get the chat id. Unset = no notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SQLite file for MARVIS questions and the event log. Keep it on a volume, e.g.
# /app/.actual-data/marvis.db with the docker-compose setup.
MARVIS_DB_PATH=marvis.db

# Finance agent (optional). Plain messages to MARVIS are forwarded to this service,
# which runs Claude and replies on Telegram. Unset = plain messages are ignored.
# With docker-compose and the service on the host: http://host.docker.internal:8790
AGENT_URL=
AGENT_TOKEN=

# Logging
LOG_LEVEL=info
PORT=8080
